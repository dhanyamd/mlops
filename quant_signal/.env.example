# ── Snowflake (trial account) ───────────────────────────────────────────────
# Account identifier WITHOUT the .snowflakecomputing.com suffix.
# Find it in Snowsight: Admin → Accounts, or in your login URL (e.g. xy12345
# or myorg-myaccount).
SNOWFLAKE_ACCOUNT=xy12345
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_DATABASE=QUANT
SNOWFLAKE_SCHEMA=BRONZE
SNOWFLAKE_WAREHOUSE=QUANT_WH
# Consumer-ready analytics marts (dbt GOLD + Spark feature batch output).
SNOWFLAKE_GOLD_SCHEMA=GOLD

# Key-pair auth (alternative to password). Leave SNOWFLAKE_PASSWORD blank and
# set these if you prefer key-pair auth (authenticator: SNOWFLAKE_JWT).
SNOWFLAKE_PRIVATE_KEY_FILE=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Modern Snowflake accounts require MFA for password logins. Enroll MFA in
# Snowsight first (Duo or authenticator app — NOT passkey), then keep these on:
SNOWFLAKE_USE_MFA=true
SNOWFLAKE_MFA_TOKEN_CACHING=true

# ── dbt (mirror the Snowflake values above) ─────────────────────────────────
# DBT_ENV_SECRET_* values are scrubbed from dbt logs automatically.
DBT_SNOWFLAKE_ACCOUNT=xy12345
DBT_SNOWFLAKE_USER=your_username
# username_password_mfa for MFA accounts; 'snowflake' for accounts without MFA
DBT_SNOWFLAKE_AUTHENTICATOR=username_password_mfa
DBT_ENV_SECRET_SNOWFLAKE_PASSWORD=your_password
DBT_SNOWFLAKE_ROLE=ACCOUNTADMIN
DBT_SNOWFLAKE_DATABASE=QUANT
DBT_SNOWFLAKE_WAREHOUSE=QUANT_WH
DBT_SNOWFLAKE_SCHEMA=BRONZE

# ── Data ingestion ──────────────────────────────────────────────────────────
# All production providers are KEYLESS and verified live:
#   - yahoo    → US equity daily OHLCV (research-grade, unofficial endpoint)
#   - binance  → crypto minute OHLCV (public API)
#   - fred     → macro series via public CSV download (fredgraph.csv)
#   - sec_edgar→ SEC EDGAR company facts (public API)
# No API keys are required. SEC EDGAR prefers a descriptive User-Agent like
# "YourName you@example.com"; leave blank to use a clearly non-production
# fallback. Set it if you want EDGAR to be production-grade.
EDGAR_USER_AGENT=YourName you@example.com

# Default instruments/series for the real ingestion flows (comma-separated).
# These are business defaults loaded from the environment — never hardcoded in
# code. Any flow also accepts explicit CLI parameters to override them.
INGEST_DEFAULT_PROVIDER=yahoo
INGEST_DEFAULT_DAYS=7000
INGEST_DEFAULT_SYMBOLS=AAPL,MSFT,NVDA,GOOGL,AMZN,META,TSLA,JPM,BAC,WFC,GS,XOM,CVX,JNJ,UNH,PFE,MRK,PG,KO,PEP,WMT,COST,DIS,HD,INTC,CSCO,IBM,ORCL
INGEST_DEFAULT_CRYPTO_SYMBOLS=BTCUSDT,ETHUSDT
INGEST_DEFAULT_MACRO_SERIES=VIXCLS,CPIAUCSL,DGS10,DGS2,FEDFUNDS,UNRATE
INGEST_DEFAULT_TICKERS=AAPL,MSFT,NVDA,GOOGL,AMZN,META,TSLA,JPM,BAC,WFC,GS,XOM,CVX,JNJ,UNH,PFE,MRK,PG,KO,PEP,WMT,COST,DIS,HD,INTC,CSCO,IBM,ORCL
INGEST_DEFAULT_METRICS=Revenues,NetIncomeLoss,Assets

# Disk cache for the Yahoo provider (research-grade, unofficial endpoint).
# Leave blank for the default (~/.cache/quant_signal/yahoo). Set a path to keep
# reruns from re-tripping Yahoo's rate limiter.
YAHOO_CACHE_DIR=

# Alpaca Market Data — the official US-equity upgrade over Yahoo (free key,
# IEX feed ≈ 2.5% of consolidated volume; paid plans add SIP). Requires a free
# alpaca.markets account. Unlike the keyless providers, leaving these blank
# makes the 'alpaca' provider unavailable (selecting it raises a clear error).
INGEST_PROVIDER_ALPACA_API_KEY=
INGEST_PROVIDER_ALPACA_SECRET_KEY=

# ── Runtime ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Dashboard API (read-only) ────────────────────────────────────────────────
# Browser origins allowed to call the API directly (CSV). The Next.js dev
# server proxies /api → :8000, so this only matters for direct cross-origin
# calls from a browser.
API_CORS_ORIGINS=http://localhost:3000
# Recompute the PEAD event study at most this often per parameter set (~10s).
API_PEAD_CACHE_TTL_SECONDS=60

# ── Live market stream (near-real-time showcase) ─────────────────────────────
# Background poller in the API process: fetches recent Binance minute bars
# (symbols from INGEST_DEFAULT_CRYPTO_SYMBOLS), persists them to
# BRONZE.CRYPTO_BARS (best-effort), and broadcasts deltas to /ws/market
# subscribers. Set false for a pure query API.
STREAM_ENABLED=true
STREAM_POLL_SECONDS=15
# Ring-buffer depth kept per symbol for WebSocket snapshots.
STREAM_HISTORY_MINUTES=180

# ── Streaming stack (M3): Kafka ingestion bus + Redis online store ───────────
# The `docker compose up -d` stack provides Redpanda (Kafka API on :9092) and
# Redis. The Redis container is remapped to :6380 so it never collides with a
# host Redis on :6379. Defaults below match the compose file — override only
# if you run your own brokers.
STREAM_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
STREAM_KAFKA_TOPIC_RAW=crypto.bars.raw
STREAM_KAFKA_TOPIC_FEATURES=crypto.features.5m
STREAM_REDIS_URL=redis://localhost:6380
STREAM_REDIS_LIVE_PREFIX=live:crypto
STREAM_REDIS_FEATURE_PREFIX=feature:crypto:5m
STREAM_REDIS_FEATURE_MAXLEN=200

# ── Prediction layer (M3.5): River + conformal intervals + Monte Carlo ───────
# Online store prefixes for the predictor and simulator outputs.
STREAM_REDIS_PREDICTION_PREFIX=prediction:crypto:5m
STREAM_REDIS_SIMULATION_PREFIX=simulation:crypto:5m
# Live strategy P&L curve (compounded equity vs buy-and-hold).
STREAM_REDIS_STRATEGY_PREFIX=strategy:crypto:5m
# Windows kept in the per-symbol strategy equity curve.
STREAM_STRATEGY_MAXLEN=500
# Adaptive Conformal Inference (Gibbs & Candès 2021): target miscoverage,
# adaptation step, and residual window for the interval quantile.
STREAM_PREDICTION_ALPHA=0.1
STREAM_PREDICTION_GAMMA=0.005
STREAM_PREDICTION_RESIDUAL_WINDOW=200
# Monte Carlo engine: paths (a power of two so the Sobol low-discrepancy net
# keeps its (0,m,s)-net stratification), forward horizon (5m steps), trailing
# windows used to estimate the per-step log-return volatility.
STREAM_SIMULATION_PATHS=16384
STREAM_SIMULATION_HORIZON_STEPS=12
STREAM_SIMULATION_VOL_WINDOWS=40
# Shock sampler: "sobol-rqmc" (scrambled Sobol low-discrepancy — near O((log
# N)^s / N) convergence vs the O(N^-1/2) of crude MC) or "crude" (numpy
# default_rng fallback). Both are seeded per window for reproducibility.
STREAM_SIMULATION_SAMPLER=sobol-rqmc
# Strategy validation Monte Carlo (QuantPad-style pass probability): bootstrap
# the realized signal returns into simulated futures and score them against
# prop-firm-style rules (max drawdown breach + profit target, e.g. Topstep 50K
# ≈ 6% target / FTMO ≈ 8-10% target, trailing DD).
STREAM_VALIDATION_SIMS=10000
STREAM_VALIDATION_MAX_DRAWDOWN=0.08
STREAM_VALIDATION_TARGET=0.06
STREAM_VALIDATION_SEED=42

# ── MLflow experiment tracking (offline validation runs) ─────────────────────
# The served models are online learners (River) + MC, so only *tracking* is
# used (params/metrics/artifacts per validation run), not the model registry.
# Requires the `mlflow` extra (uv sync --extra mlflow). Without it, tracking
# is a no-op. Tracking is explicit (?track=true) so the 15s UI poll never
# spams runs.
MLFLOW_TRACKING_ENABLED=false
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=quant_signal

# ── Execution venue ──────────────────────────────────────────────────────────
# "paper" fills at the next window's close with a fixed slippage/taker-fee
# model (no real orders). "bybit-demo" places REAL market orders on Bybit's
# free Demo Trading account (virtual USDT — no deposit, no KYC); fill prices,
# qty and fees come from the venue. Without the keys below, bybit-demo falls
# back to paper at startup.
# To enable: bybit.com → sign up (free) → profile → Demo Trading (auto-credits
# 50k USDT + 1 BTC) → API Management → Create New Key (trade permission) →
# paste below. Keys from the Demo account only work on api-demo.bybit.com.
STREAM_EXECUTION_VENUE=paper
BYBIT_DEMO_API_KEY=
BYBIT_DEMO_API_SECRET=
# Signed-request tolerance window (ms) for the demo venue.
BYBIT_DEMO_RECV_WINDOW_MS=5000

